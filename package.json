{
  "name": "melonite-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run content && tsc --noEmit",
    "content": "node scripts/generate-content.ts",
    "check:build": "node scripts/check-build.ts",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "echarts": "6.1.0",
    "three": "0.168.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "@types/three": "^0.168.0",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.3",
    "satori": "0.63.2",
    "typescript": "^5.9.3",
    "vite": "6.4.6",
    "wrangler": "4.161.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

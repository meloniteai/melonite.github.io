    "@fontsource/cormorant-garamond": "5.3.0",
    "three": "0.168.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "^0.168.0",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.3",
    "typescript": "^5.9.3",
    "vite": "5.4.21"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

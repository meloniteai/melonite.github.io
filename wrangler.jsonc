{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "melonite-markdown",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-29",
  "account_id": "4a7ed2e62cdc3d78754193988985554b",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "melonite.ai/",
      "zone_name": "melonite.ai"
    },
    {
      "pattern": "melonite.ai/index.md",
      "zone_name": "melonite.ai"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ]
}
